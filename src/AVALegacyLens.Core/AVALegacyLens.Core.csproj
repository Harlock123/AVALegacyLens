<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reading a legacy system: the scanners (Roslyn for VB.NET and C#, later T-SQL and VB6), the system map they build,
       the .lens file, and everything worked out from the map. No Avalonia, so the tests check it without a window. -->
  <PropertyGroup>
    <RootNamespace>AVALegacyLens.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    <!-- T-SQL: Microsoft's own parser, for scripts, embedded SQL and the modules of a live database. -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.107.0" />
    <!-- A live SQL Server's catalog (sys.tables, sys.sql_modules…): its schema only, never its rows. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <!-- SqlClient 6.1 pulls in Pkcs 9.0.11, which has known advisories; take the patched one. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVALegacyLens.Tests" />
  </ItemGroup>
</Project>
